#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        vimquit: vimquit {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ESCAPE &kp COLON &kp Q &kp EXCLAMATION &kp ENTER>;
            label = "VIMQUIT";
        };

        vimsave: vimsave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ESCAPE &kp COLON &kp W &kp Q &kp EXCLAMATION &kp ENTER>;
            label = "VIMSAVE";
        };

        vim_showNum: vim_showNum {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ESCAPE &kp COLON &kp S &kp E &kp T &kp N &kp U &kp M &kp RET>;
            label = "VIM_SHOWNUM";
        };

        nvim_splitTerminal: nvim_splitTerminal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp COLON &kp S &kp P &kp L &kp I &kp T &kp SPACE &kp PIPE &kp SPACE &kp T &kp E &kp R &kp M &kp I &kp N &kp A &kp L &kp RET>;
            label = "NVIM_SPLITTERMINAL";
        };

        nvim_focus_off_term: normal_from_terminal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(NON_US_BACKSLASH) &kp LC(N)>;
            label = "NORMAL_FROM_TERMINAL";
        };

        nvim_close_splits: nvim_close_splits {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp COLON &kp O &kp N &kp L &kp Y>;
            label = "NVIM_CLOSE_SPLITS";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1         &kp N2     &kp N3      &kp N4     &kp N5  &tog 1                                                  &mo 3      &kp N6  &kp N7  &kp N8    &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp SQT        &kp COMMA  &kp PERIOD  &kp P      &kp Y   &none                                                   &none      &kp F   &kp G   &kp C     &kp R     &kp L     &kp BSLH
&kp ESC    &kp A          &kp O      &kp E       &kp U      &kp I   &none     &kp LGUI  &kp LALT       &kp LGUI  &kp RCTRL  &none      &kp D   &kp H   &kp T     &kp N     &kp S     &kp SLASH
&kp LSHFT  &kp SEMICOLON  &kp Q      &kp J       &kp K      &kp X                       &kp LG(C)      &vimquit                        &kp B   &kp M   &kp W     &kp V     &kp Z     &kp RSHFT
&mo 10     &kp GRAVE      &kp CAPS   &kp LEFT    &kp RIGHT          &kp BSPC  &kp DEL   &kp LG(V)      &vimsave  &kp ENTER  &kp SPACE          &kp UP  &kp DOWN  &kp LBKT  &kp RBKT  &mo 2
            >;
        };

        numpad_layer {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1         &kp N2     &kp N3      &kp N4     &kp N5  &trans                                                   &mo 3      &kp N6  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp SQT        &kp COMMA  &kp PERIOD  &kp P      &kp Y   &none                                                    &none      &kp F   &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&kp ESC    &kp A          &kp O      &kp E       &kp U      &kp I   &none     &kp LCTRL  &kp LALT       &kp LGUI  &kp SPACE  &none      &kp D   &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&kp LSHFT  &kp SEMICOLON  &kp Q      &kp J       &kp K      &kp X                        &kp LG(C)      &none                           &kp B   &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&mo 2      &kp GRAVE      &kp CAPS   &kp LEFT    &kp RIGHT          &kp BSPC  &kp DEL    &kp LG(V)      &none     &kp ENTER  &kp KP_N0          &kp UP      &kp DOWN      &kp KP_DOT     &kp RBKT         &mo 2
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2         &kp F3  &kp F4              &kp F5         &kp F6  &tog 1                                       &mo 3   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans         &trans  &trans              &trans         &trans  &none                                        &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &kp LC(A)      &trans  &kp LC(E)           &trans         &trans  &tog 10  &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &kp LC(LG(Q))  &trans  &kp LC(UP_ARROW)    &trans         &trans                   &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &tog 9         &tog 8  &kp LC(LEFT_ARROW)  &kp LC(RIGHT)          &trans   &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans                  &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader             &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &rgb_ug RGB_MEFS_CMD 5  &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none                             &none      &none                                           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG                &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        Shortcuts {
            bindings = <
&trans  &kp LC(LA(LEFT))      &kp LA(LG(RIGHT))     &kp LA(LC(E))  &kp LA(LC(T))  &kp LA(LC(I))  &trans                                             &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans                &trans                &trans         &kp LA(LC(D))  &kp LA(LC(K))  &trans                                             &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LS(LG(NUMBER_3))  &kp LS(LG(NUMBER_4))  &trans         &kp LA(LC(F))  &kp LA(LC(U))  &kp LS(LG(V))  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans                &trans                &trans         &kp LA(LC(G))  &kp LA(LC(J))                         &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans                &trans                &trans         &trans                        &trans         &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        Game_mode {
            bindings = <
&trans     &kp N1  &kp N2  &kp N3    &kp N4     &kp N5  &trans                                               &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans     &kp Q   &kp W   &kp E     &kp R      &kp T   &trans                                               &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans     &kp A   &kp S   &kp D     &kp F      &kp G   &trans     &kp LGUI   &kp LALT       &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp LSHFT  &kp Z   &kp X   &kp C     &kp V      &kp B                         &kp LCTRL      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans     &trans  &trans  &kp LEFT  &kp RIGHT          &kp SPACE  &kp ENTER  &kp M          &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        nvim_shortcuts {
            bindings = <
&trans                &vim_showNum  &trans  &trans  &trans  &trans  &trans                                                    &trans  &trans  &trans  &trans               &trans  &trans  &trans
&trans                &trans        &trans  &trans  &trans  &trans  &trans                                                    &trans  &trans  &trans  &trans               &trans  &trans  &trans
&nvim_focus_off_term  &trans        &trans  &trans  &trans  &trans  &trans              &trans  &trans      &trans    &trans  &trans  &trans  &trans  &nvim_splitTerminal  &trans  &trans  &trans
&trans                &trans        &trans  &trans  &trans  &trans                              &trans      &vimquit                  &trans  &trans  &trans               &trans  &trans  &trans
&trans                &trans        &trans  &trans  &trans          &nvim_close_splits  &trans  &trans      &vimsave  &trans  &trans          &trans  &trans               &trans  &trans  &trans
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        purple_is_5 {
            if-layers = <8>;
            then-layer = <5>;
        };

        red_is_2 {
            if-layers = <7>;
            then-layer = <2>;
        };

        cyan_is_4 {
            if-layers = <9>;
            then-layer = <4>;
        };

        yellow_is_6 {
            if-layers = <10>;
            then-layer = <6>;
        };
    };
};
